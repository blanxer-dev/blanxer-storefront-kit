{
  "name": "blanxer-storefront-kit",
  "private": true,
  "version": "0.0.0",
  "description": "@blanxer/storefront (npm package) and the Blanxer storefront starter (Next.js 16 + Cloudflare).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blanxer-dev/blanxer-storefront-kit.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @blanxer/storefront",
    "test": "npm test -w @blanxer/storefront",
    "typecheck": "npm run typecheck -w @blanxer/storefront",
    "build:starter": "npm run build -w blanxer-storefront-starter",
    "check": "npm run check -w blanxer-storefront-starter"
  },
  "engines": {
    "node": ">=20.9"
  }
}
