# Your Blanxer store: the subdomain in <subdomain>.blanxer.io (or its custom domain). Required.
BLANXER_STORE=

# Optional. Blanxer API base. Default https://api.blanxer.com
# (sandbox: https://api-dev.blanxer.com)
# BLANXER_API=https://api.blanxer.com

# Optional. The site's public URL, for canonical links, robots.txt and the
# sitemap index. When unset, the store's website link saved in Blanxer is used.
# SITE_URL=https://shop.example.com

# Optional. Product photo resizing for next/image: wsrv (default) | cloudflare | none
# NEXT_PUBLIC_BLANXER_IMAGE_LOADER=wsrv

# Never put an sk_ API key, MCP token, password or payment gateway key here.
# The site needs no secret.
