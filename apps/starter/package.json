{
  "name": "blanxer-storefront-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 16 starter for a custom Blanxer store website (BlanxerAPI), deployed to Cloudflare Workers.",
  "homepage": "https://developers.blanxer.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blanxer-dev/blanxer-storefront-starter.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check": "blanxer-storefront check",
    "images": "blanxer-storefront images",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@blanxer-dev/storefront": "^0.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
